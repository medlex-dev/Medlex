<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedLatin Duolingo - Вивчення Латини</title>
    <style>
        :root {
            --bg-dark-1: #0d061a;
            --bg-dark-2: #180933;
            --container-bg: #1e0c3e;
            --container-border: #3c1a78;
            --header-bg: #160830;
            
            --purple-main: #9333ea;
            --purple-light: #c084fc;
            --purple-soft: #e9d5ff;
            --purple-dark: #6b21a8;
            --purple-btn: #2e1065;
            --purple-btn-hover: #3b147d;

            --green-correct: #22c55e;
            --red-wrong: #ef4444;
            --gold-star: #fbbf24;
            
            --text-white: #ffffff;
            --text-sub: #d8b4fe;
            --card-shadow: 0 12px 0 0 #0f0521;
        }

        /* THEME 1: CYBERPUNK (500 Stars) */
        body.theme-cyberpunk {
            --bg-dark-1: #030814;
            --bg-dark-2: #081226;
            --container-bg: #0b1a36;
            --container-border: #00f0ff;
            --header-bg: #061124;
            
            --purple-main: #00f0ff;
            --purple-light: #7000ff;
            --purple-soft: #a5f3fc;
            --purple-dark: #00a8b3;
            --purple-btn: #0e2a52;
            --purple-btn-hover: #163d75;

            --text-white: #ffffff;
            --text-sub: #67e8f9;
            --card-shadow: 0 12px 0 0 #020b18;
        }

        /* THEME 2: EMERALD NATURE (700 Stars) */
        body.theme-emerald {
            --bg-dark-1: #021a12;
            --bg-dark-2: #062e20;
            --container-bg: #0b402d;
            --container-border: #10b981;
            --header-bg: #042418;
            
            --purple-main: #10b981;
            --purple-light: #6ee7b7;
            --purple-soft: #d1fae5;
            --purple-dark: #047857;
            --purple-btn: #064e3b;
            --purple-btn-hover: #065f46;

            --text-white: #ffffff;
            --text-sub: #a7f3d0;
            --card-shadow: 0 12px 0 0 #01120c;
        }

        /* THEME 3: IMPERIAL GOLD (1000 Stars) */
        body.theme-gold {
            --bg-dark-1: #1f1402;
            --bg-dark-2: #362304;
            --container-bg: #4a3207;
            --container-border: #eab308;
            --header-bg: #291a03;
            
            --purple-main: #eab308;
            --purple-light: #fef08a;
            --purple-soft: #fef9c3;
            --purple-dark: #a16207;
            --purple-btn: #5c3e08;
            --purple-btn-hover: #78510a;

            --text-white: #ffffff;
            --text-sub: #fde047;
            --card-shadow: 0 12px 0 0 #120b01;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            user-select: none;
        }

        body {
            background: linear-gradient(135deg, var(--bg-dark-1) 0%, var(--bg-dark-2) 100%);
            min-height: 100vh;
            color: var(--text-white);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px;
            transition: background 0.3s ease;
        }

        .header {
            width: 100%;
            max-width: 720px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--header-bg);
            padding: 12px 20px;
            border-radius: 20px;
            box-shadow: 0 6px 0 #0f0521, 0 10px 25px rgba(0, 0, 0, 0.4);
            margin-bottom: 20px;
            border: 2px solid var(--container-border);
            transition: all 0.3s ease;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
            font-size: 22px;
            color: var(--purple-light);
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: var(--purple-main);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 4px 0 var(--purple-dark);
        }

        .stats-bar {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 800;
            font-size: 16px;
            background: rgba(0,0,0,0.3);
            padding: 6px 12px;
            border-radius: 12px;
            border: 2px solid var(--container-border);
        }

        .stat-item.streak { color: #fb923c; }
        .stat-item.xp { color: var(--gold-star); }

        .container {
            width: 100%;
            max-width: 720px;
            background: var(--container-bg);
            border-radius: 28px;
            padding: 28px 24px;
            box-shadow: var(--card-shadow), 0 15px 35px rgba(0, 0, 0, 0.5);
            border: 3px solid var(--container-border);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 520px;
            transition: all 0.3s ease;
        }

        .screen {
            display: none;
            flex-direction: column;
            height: 100%;
            flex-grow: 1;
        }

        .screen.active {
            display: flex;
        }

        .menu-title {
            font-size: 26px;
            font-weight: 900;
            text-align: center;
            color: var(--purple-light);
            margin-bottom: 8px;
        }

        .menu-subtitle {
            font-size: 15px;
            text-align: center;
            color: var(--text-sub);
            margin-bottom: 24px;
            font-weight: 600;
        }

        .option-group {
            margin-bottom: 20px;
        }

        .option-label {
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--purple-light);
            margin-bottom: 10px;
            display: block;
        }

        .grid-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 10px;
        }

        .opt-btn {
            background: var(--purple-btn);
            border: 2px solid var(--container-border);
            border-bottom: 5px solid rgba(0,0,0,0.4);
            border-radius: 16px;
            padding: 14px 10px;
            font-weight: 800;
            font-size: 14px;
            color: var(--text-white);
            cursor: pointer;
            transition: all 0.15s ease;
            text-align: center;
        }

        .opt-btn:hover {
            background: var(--purple-btn-hover);
            border-color: var(--purple-light);
        }

        .opt-btn.selected {
            background: var(--purple-main);
            color: white;
            border-color: var(--purple-light);
            border-bottom: 5px solid var(--purple-dark);
        }

        .start-btn {
            background: #22c55e;
            color: white;
            border: none;
            border-bottom: 6px solid #15803d;
            border-radius: 20px;
            padding: 18px;
            font-size: 20px;
            font-weight: 900;
            cursor: pointer;
            width: 100%;
            margin-top: auto;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.1s ease;
        }

        .start-btn:active {
            transform: translateY(3px);
            border-bottom-width: 3px;
        }

        .shop-btn {
            background: #eab308;
            color: #1a0f00;
            border: none;
            border-bottom: 5px solid #a16207;
            border-radius: 16px;
            padding: 14px;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.1s ease;
        }

        .shop-btn:active {
            transform: translateY(2px);
            border-bottom-width: 3px;
        }

        .progress-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .progress-bar-bg {
            flex-grow: 1;
            height: 16px;
            background: rgba(0,0,0,0.4);
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid var(--container-border);
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--purple-main), var(--purple-light));
            border-radius: 10px;
            transition: width 0.3s ease;
        }

        .timer-badge {
            align-self: center;
            background: #451a03;
            border: 2px solid #f59e0b;
            color: #fde68a;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 900;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 12px;
            text-align: center;
        }

        .timer-badge.expired {
            background: #450a0a;
            border-color: #ef4444;
            color: #fca5a5;
        }

        .cards-wrapper {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        @media (max-width: 500px) {
            .cards-wrapper {
                flex-direction: column;
            }
        }

        .word-card {
            flex: 1;
            background: rgba(0,0,0,0.2);
            border: 3px solid var(--container-border);
            border-bottom: 6px solid rgba(0,0,0,0.4);
            border-radius: 20px;
            padding: 20px 16px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 110px;
        }

        .word-card.hidden-card {
            background: rgba(0,0,0,0.3);
            border-color: var(--container-border);
            border-style: dashed;
        }

        .card-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            color: var(--purple-light);
            margin-bottom: 8px;
        }

        .card-text {
            font-size: 20px;
            font-weight: 900;
            color: var(--text-white);
            word-break: break-word;
        }

        .card-hidden-placeholder {
            font-size: 26px;
            font-weight: 900;
            color: var(--purple-light);
        }

        /* 5 CARDS MODE STYLES */
        .cards-5-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: 10px;
            margin-bottom: 20px;
            width: 100%;
        }

        .card-5-item {
            background: rgba(0,0,0,0.25);
            border: 2px solid var(--container-border);
            border-bottom: 5px solid rgba(0,0,0,0.4);
            border-radius: 18px;
            padding: 12px 8px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 110px;
            transition: all 0.3s ease;
        }

        .card-5-item.hidden {
            opacity: 0;
            transform: scale(0.8);
            pointer-events: none;
        }

        .card-5-item.target-active {
            background: rgba(255,255,255,0.1);
            border-color: var(--purple-light);
            border-bottom: 5px solid var(--purple-main);
            transform: scale(1.05);
        }

        .card-5-prompt {
            font-size: 15px;
            font-weight: 800;
            color: var(--text-white);
            word-break: break-word;
        }

        .card-5-target {
            font-size: 13px;
            font-weight: 700;
            color: var(--purple-light);
            margin-top: 6px;
            border-top: 1px dashed var(--container-border);
            padding-top: 4px;
            width: 100%;
            word-break: break-word;
        }

        .input-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 10px;
        }

        .answer-input {
            width: 100%;
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 700;
            border: 3px solid var(--container-border);
            border-radius: 18px;
            outline: none;
            background: rgba(0,0,0,0.25);
            color: var(--text-white);
        }

        .answer-input:focus {
            border-color: var(--purple-light);
            background: rgba(0,0,0,0.35);
        }

        .answer-input:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            background: rgba(0,0,0,0.4);
        }

        .action-btn {
            background: var(--purple-main);
            color: white;
            border: none;
            border-bottom: 5px solid var(--purple-dark);
            border-radius: 18px;
            padding: 16px;
            font-size: 18px;
            font-weight: 900;
            cursor: pointer;
            text-transform: uppercase;
        }

        .action-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .skip-timer-btn {
            background: rgba(0,0,0,0.2);
            border: 2px solid var(--container-border);
            color: var(--purple-light);
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            align-self: center;
            margin-bottom: 12px;
        }

        .feedback-banner {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 20px 24px;
            display: none;
            flex-direction: column;
            gap: 12px;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
            z-index: 10;
        }

        .feedback-banner.correct {
            display: flex;
            background: #14532d;
            border-top: 4px solid #22c55e;
            color: #dcfce7;
        }

        .feedback-banner.wrong {
            display: flex;
            background: #7f1d1d;
            border-top: 4px solid #ef4444;
            color: #fee2e2;
        }

        .fb-header {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 900;
        }

        .fb-details {
            font-size: 15px;
            font-weight: 700;
        }

        .next-btn {
            border: none;
            border-radius: 16px;
            padding: 14px;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            text-transform: uppercase;
        }

        .correct .next-btn {
            background: #22c55e;
            color: white;
            border-bottom: 4px solid #15803d;
        }

        .wrong .next-btn {
            background: #ef4444;
            color: white;
            border-bottom: 4px solid #b91c1c;
        }

        .summary-card {
            text-align: center;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            width: 100%;
            margin: 16px 0;
        }

        .stat-box {
            background: rgba(0,0,0,0.25);
            border: 2px solid var(--container-border);
            border-radius: 18px;
            padding: 16px;
            text-align: center;
        }

        .stat-box-num {
            font-size: 26px;
            font-weight: 900;
            color: var(--purple-light);
        }

        .stat-box-lbl {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-sub);
            text-transform: uppercase;
        }

        .dict-list {
            overflow-y: auto;
            max-height: 380px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding-right: 6px;
            margin-top: 12px;
        }

        .dict-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0,0,0,0.25);
            padding: 12px 16px;
            border-radius: 14px;
            border: 2px solid var(--container-border);
        }

        .dict-lat {
            font-weight: 800;
            color: var(--purple-light);
            font-size: 15px;
        }

        .dict-ukr {
            font-weight: 700;
            color: var(--text-white);
            font-size: 14px;
            text-align: right;
        }

        .search-box {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--container-border);
            border-radius: 14px;
            font-size: 15px;
            outline: none;
            background: rgba(0,0,0,0.25);
            color: var(--text-white);
            margin-bottom: 10px;
        }

        /* SHOP CARDS STYLES */
        .shop-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 14px;
            margin-top: 14px;
            max-height: 380px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .shop-card {
            background: rgba(0,0,0,0.25);
            border: 2px solid var(--container-border);
            border-bottom: 5px solid rgba(0,0,0,0.4);
            border-radius: 20px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            text-align: center;
        }

        .shop-card-preview {
            width: 100%;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 18px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
        }

        .shop-card-title {
            font-weight: 900;
            font-size: 17px;
            color: var(--text-white);
        }

        .shop-card-price {
            font-weight: 800;
            font-size: 15px;
            color: var(--gold-star);
        }

        .shop-item-btn {
            width: 100%;
            padding: 10px;
            border-radius: 14px;
            border: none;
            font-weight: 900;
            font-size: 14px;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.15s ease;
        }

        .shop-item-btn.buy {
            background: #22c55e;
            color: white;
            border-bottom: 4px solid #15803d;
        }

        .shop-item-btn.equip {
            background: var(--purple-main);
            color: white;
            border-bottom: 4px solid var(--purple-dark);
        }

        .shop-item-btn.active {
            background: #4b5563;
            color: #d1d5db;
            cursor: default;
        }

        .shop-item-btn.disabled {
            background: #374151;
            color: #9ca3af;
            cursor: not-allowed;
        }
    </style>
</head>
<body class="theme-default">

    <div class="header">
        <div class="logo">
            <div class="logo-icon">🏛️</div>
            MedLatin
        </div>
        <div class="stats-bar">
            <div class="stat-item streak">🔥 <span id="streak-val">0</span></div>
            <div class="stat-item xp">⭐ <span id="xp-val">0</span></div>
        </div>
    </div>

    <div class="container">

        <!-- SCREEN 1: MENU -->
        <div id="screen-menu" class="screen active">
            <h1 class="menu-title">Медична Латина</h1>
            <p class="menu-subtitle">Вивчайте слова в ігровій формі (+5 ⭐ за кожне слово)</p>

            <div class="option-group">
                <span class="option-label">Оберіть режим:</span>
                <div class="grid-options">
                    <button class="opt-btn selected" onclick="setMode('timer', this)">⏱️ 5 секунд<br><small style="font-weight:600;font-size:11px;">1 слово</small></button>
                    <button class="opt-btn" onclick="setMode('cards5', this)">🧠 5 слів<br><small style="font-weight:600;font-size:11px;">Запам'ятай 5 ➔ Напиши 1</small></button>
                    <button class="opt-btn" onclick="setMode('quick', this)">⚡ Швидкий<br><small style="font-weight:600;font-size:11px;">Прямий переклад</small></button>
                    <button class="opt-btn" onclick="openDict()">📚 Словник<br><small style="font-weight:600;font-size:11px;">Усі 94 слова</small></button>
                </div>
            </div>

            <div class="option-group">
                <span class="option-label">Напрямок перекладу:</span>
                <div class="grid-options">
                    <button class="opt-btn selected" onclick="setDir('lat-ukr', this)">Латина ➔ Укр</button>
                    <button class="opt-btn" onclick="setDir('ukr-lat', this)">Укр ➔ Латина</button>
                    <button class="opt-btn" onclick="setDir('mix', this)">🔀 Мікс</button>
                </div>
            </div>

            <div class="option-group">
                <span class="option-label">Тема / Категорія:</span>
                <div class="grid-options">
                    <button class="opt-btn selected" onclick="setCat('all', this)">🌐 Всі (94)</button>
                    <button class="opt-btn" onclick="setCat('anat', this)">🫀 Анатомія (79)</button>
                    <button class="opt-btn" onclick="setCat('vit', this)">💊 Вітаміни (15)</button>
                </div>
            </div>

            <button class="start-btn" onclick="startGame()">Розпочати гру</button>
            <button class="shop-btn" onclick="openShop()">🛒 Магазин Стилів</button>
        </div>

        <!-- SCREEN 2: GAMEPLAY -->
        <div id="screen-game" class="screen">
            <div class="progress-container">
                <button onclick="confirmExit()" style="background:none; border:none; font-size:20px; cursor:pointer; color: var(--purple-light);">✖</button>
                <div class="progress-bar-bg">
                    <div id="progress-fill" class="progress-fill"></div>
                </div>
                <span id="progress-text" style="font-weight:800; font-size:14px; color:var(--purple-light);">1/10</span>
            </div>

            <div id="timer-badge" class="timer-badge">
                ⏳ Запам'ятайте слово: <span id="timer-seconds" style="font-size:18px;">5</span>с
            </div>

            <button id="skip-timer-btn" class="skip-timer-btn" onclick="skipTimer()">Я вже запам'ятав! ➔</button>

            <!-- Standard 2 Cards Layout -->
            <div class="cards-wrapper" id="standard-cards-wrapper">
                <div class="word-card">
                    <span class="card-label" id="left-card-label">Латина</span>
                    <span class="card-text" id="left-card-text">Cor, cordis n</span>
                </div>

                <div class="word-card" id="right-card">
                    <span class="card-label" id="right-card-label">Переклад (Укр)</span>
                    <span class="card-text" id="right-card-text">серце</span>
                </div>
            </div>

            <!-- 5 Cards Layout -->
            <div class="cards-5-grid" id="cards-5-wrapper" style="display:none;"></div>

            <div class="input-section">
                <input type="text" id="answer-input" class="answer-input" placeholder="Напишіть слово тут..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
                <button id="check-btn" class="action-btn" onclick="checkAnswer()">Перевірити</button>
