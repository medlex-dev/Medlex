                const rightCardText = document.getElementById('right-card-text');

                rightCard.classList.remove('hidden-card');
                rightCardText.innerText = currentQuestion.targetText;

                const timerBadge = document.getElementById('timer-badge');
                timerBadge.style.display = 'flex';
                timerBadge.classList.remove('expired');
                timerBadge.innerHTML = `⏳ Запам'ятайте слово: <span id="timer-seconds" style="font-size:18px;">5</span>с`;

                document.getElementById('skip-timer-btn').style.display = 'block';

                inputEl.disabled = true;
                inputEl.placeholder = "⏳ Зачекайте 5 секунд (запам'ятовування)...";
                checkBtn.disabled = true;

                timeLeft = 5;

                timerInterval = setInterval(() => {
                    timeLeft--;
                    const timerSecEl = document.getElementById('timer-seconds');
                    if (timerSecEl) {
                        timerSecEl.innerText = Math.max(0, timeLeft);
                    }
                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        switchToAnsweringPhase();
                    }
                }, 1000);

            } else {
                stdWrapper.style.display = 'flex';
                cards5Wrapper.style.display = 'none';

                document.getElementById('left-card-label').innerText = currentQuestion.promptLabel;
                document.getElementById('left-card-text').innerText = currentQuestion.promptText;
                document.getElementById('right-card-label').innerText = currentQuestion.targetLabel;

                document.getElementById('timer-badge').style.display = 'none';
                document.getElementById('skip-timer-btn').style.display = 'none';

                const rightCard = document.getElementById('right-card');
                const rightCardText = document.getElementById('right-card-text');

                rightCard.classList.add('hidden-card');
                rightCardText.innerHTML = '<span class="card-hidden-placeholder">???</span>';

                inputEl.disabled = false;
                inputEl.placeholder = "Напишіть слово тут...";
                checkBtn.disabled = false;
                inputEl.focus();
            }
        }

        function renderCards5Initial() {
            const wrapper = document.getElementById('cards-5-wrapper');
            wrapper.innerHTML = '';
            cards5List.forEach(c => {
                const div = document.createElement('div');
                div.className = 'card-5-item';
                div.innerHTML = `
                    <div class="card-5-prompt">${c.prompt}</div>
                    <div class="card-5-target">${c.target}</div>
                `;
                wrapper.appendChild(div);
            });
        }

        function skipTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            if (gameConfig.mode === 'cards5') {
                switchToAnsweringPhaseCards5();
            } else {
                switchToAnsweringPhase();
            }
        }

        function switchToAnsweringPhaseCards5() {
            const timerBadge = document.getElementById('timer-badge');
            timerBadge.classList.add('expired');
            timerBadge.innerHTML = '🔒 Напишіть переклад залишеного слова:';
            document.getElementById('skip-timer-btn').style.display = 'none';

            cards5List = cards5List.sort(() => 0.5 - Math.random());

            const wrapper = document.getElementById('cards-5-wrapper');
            wrapper.innerHTML = '';

            cards5List.forEach((c) => {
                const div = document.createElement('div');
                if (c.isTarget) {
                    div.className = 'card-5-item target-active';
                    div.innerHTML = `
                        <div class="card-5-prompt" style="font-size:17px; color:var(--purple-light);">${c.prompt}</div>
                        <div class="card-5-target" style="font-size:16px;">???</div>
                    `;
                } else {
                    div.className = 'card-5-item hidden';
                    div.innerHTML = '';
                }
                wrapper.appendChild(div);
            });

            const inputEl = document.getElementById('answer-input');
            const checkBtn = document.getElementById('check-btn');

            inputEl.disabled = false;
            inputEl.placeholder = "Напишіть переклад і натисніть Enter...";
            checkBtn.disabled = false;
            inputEl.focus();
        }

        function switchToAnsweringPhase() {
            const rightCard = document.getElementById('right-card');
            const rightCardText = document.getElementById('right-card-text');

            const timerBadge = document.getElementById('timer-badge');
            timerBadge.classList.add('expired');
            timerBadge.innerHTML = '🔒 Час вичерпано! Напишіть переклад нижче:';
            document.getElementById('skip-timer-btn').style.display = 'none';

            rightCard.classList.add('hidden-card');
            rightCardText.innerHTML = '<span class="card-hidden-placeholder">???</span>';

            const inputEl = document.getElementById('answer-input');
            const checkBtn = document.getElementById('check-btn');

            inputEl.disabled = false;
            inputEl.placeholder = "Напишіть відповідь і натисніть Enter...";
            checkBtn.disabled = false;
            inputEl.focus();
        }

        function normalizeStr(str) {
            if (!str) return '';
            return str
                .toLowerCase()
                .replace(/['’`ʼ]/g, "'")
                .replace(/[\(\)\,\.\/\-\–\—]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }

        function checkAnswer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }

            const inputEl = document.getElementById('answer-input');
            const userAns = inputEl.value;
            if (!userAns.trim()) return;

            const target = currentQuestion.targetText;
            const normUser = normalizeStr(userAns);
            const normTarget = normalizeStr(target);

            let isCorrect = (normUser === normTarget);

            if (!isCorrect) {
                const options = target.split(/[\/\,\;]/).map(s => normalizeStr(s));
                if (options.some(opt => opt === normUser || (opt.length > 2 && normUser === opt))) {
                    isCorrect = true;
                }
            }

            if (gameConfig.mode === 'cards5') {
                const targetCardEl = document.querySelector('.card-5-item.target-active .card-5-target');
                if (targetCardEl) {
                    targetCardEl.innerText = target;
                    targetCardEl.style.color = '#22c55e';
                }
            } else {
                const rightCard = document.getElementById('right-card');
                const rightCardText = document.getElementById('right-card-text');
                rightCard.classList.remove('hidden-card');
                rightCardText.innerText = target;
            }

            inputEl.disabled = true;
            document.getElementById('check-btn').disabled = true;

            const banner = document.getElementById('feedback-banner');
            const fbTitle = document.getElementById('fb-title');
            const fbDesc = document.getElementById('fb-desc');

            if (isCorrect) {
                playSound('correct');
                banner.className = 'feedback-banner correct';
                fbTitle.innerHTML = '<span>🎉</span> Відмінно!';
                fbDesc.innerText = `Правильна відповідь: ${target}`;
                
                streak++;
                xp += 5; // +5 stars per correct word
                correctCount++;

                document.getElementById('streak-val').innerText = streak;
                document.getElementById('xp-val').innerText = xp;
                saveState();
            } else {
                playSound('wrong');
                banner.className = 'feedback-banner wrong';
                fbTitle.innerHTML = '<span>❌</span> Незовсім так';
                fbDesc.innerText = `Правильно: ${target}`;
                
                streak = 0;
                document.getElementById('streak-val').innerText = streak;
                saveState();
            }

            banner.style.display = 'flex';
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                const gameScreen = document.getElementById('screen-game');
                if (gameScreen.classList.contains('active')) {
                    const banner = document.getElementById('feedback-banner');
                    if (banner.style.display === 'flex') {
                        nextQuestion();
                    } else if (!document.getElementById('answer-input').disabled) {
                        checkAnswer();
                    }
                }
            }
        });

        function nextQuestion() {
            currentIndex++;
            if (currentIndex >= currentQueue.length) {
                finishSession();
            } else {
                loadQuestion();
            }
        }

        function finishSession() {
            showScreen('screen-summary');
            document.getElementById('summary-score').innerText = `${correctCount}/${currentQueue.length}`;
            document.getElementById('summary-xp').innerText = `+${correctCount * 5}`;
            saveState();
        }

        function confirmExit() {
            if (confirm('Ви впевнені, що хочете вийти з уроку?')) {
                if (timerInterval) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                }
                showScreen('screen-menu');
            }
        }
    </script>
</body>
</html>
