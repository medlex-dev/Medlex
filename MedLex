            document.getElementById('feedback-banner').style.display = 'none';
            const inputEl = document.getElementById('answer-input');
            const checkBtn = document.getElementById('check-btn');

            inputEl.value = '';

            const total = currentQueue.length;
            const current = currentIndex + 1;
            document.getElementById('progress-fill').style.width = `${(currentIndex / total) * 100}%`;
            document.getElementById('progress-text').innerText = `${current}/${total}`;

            const item = currentQueue[currentIndex];
            
            let isLatToUkr = true;
            if (gameConfig.dir === 'ukr-lat') isLatToUkr = false;
            else if (gameConfig.dir === 'mix') isLatToUkr = Math.random() > 0.5;

            currentQuestion = {
                item: item,
                promptText: isLatToUkr ? item.latin : item.ukr,
                promptLabel: isLatToUkr ? 'Латина' : 'Українська',
                targetText: isLatToUkr ? item.ukr : item.latin,
                targetLabel: isLatToUkr ? 'Переклад (Укр)' : 'Латинська назва'
            };

            const stdWrapper = document.getElementById('standard-cards-wrapper');
            const cards5Wrapper = document.getElementById('cards-5-wrapper');

            if (gameConfig.mode === 'cards5') {
                stdWrapper.style.display = 'none';
                cards5Wrapper.style.display = 'grid';

                let pool = vocabulary;
                if (gameConfig.cat === 'anat') pool = vocabulary.filter(w => w.cat === 'Анатомія');
                if (gameConfig.cat === 'vit') pool = vocabulary.filter(w => w.cat === 'Вітаміни');

                let distractors = pool.filter(w => w.latin !== item.latin).sort(() => 0.5 - Math.random()).slice(0, 4);
                let rawList = [item, ...distractors].sort(() => 0.5 - Math.random());

                cards5List = rawList.map(w => {
                    return {
                        prompt: isLatToUkr ? w.latin : w.ukr,
                        target: isLatToUkr ? w.ukr : w.latin,
                        isTarget: (w.latin === item.latin)
